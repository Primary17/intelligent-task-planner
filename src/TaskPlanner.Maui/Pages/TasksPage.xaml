<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskPlanner.Maui.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:api="clr-namespace:TaskPlanner.Maui.Api"
    xmlns:loc="clr-namespace:TaskPlanner.Maui.Localization"
    xmlns:vm="clr-namespace:TaskPlanner.Maui.ViewModels"
    Title="{loc:Loc Nav_Tasks}"
    x:DataType="vm:TasksViewModel">

    <Grid Padding="16,12" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Button
            Grid.Row="0"
            Command="{Binding CreateNewCommand}"
            HorizontalOptions="End"
            Text="{loc:Loc Common_Add}" />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <ActivityIndicator HorizontalOptions="Start" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" />
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView
                    x:Name="TaskCollection"
                    ItemsSource="{Binding Items}"
                    SelectionChanged="OnTaskSelected"
                    SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="api:StudyTaskDto">
                            <Border Margin="0,6" Padding="14" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label FontAttributes="Bold" FontSize="16" Text="{Binding Title}" />
                                        <Label Grid.Column="1" Style="{StaticResource Caption}">
                                            <Label.Text>
                                                <MultiBinding Converter="{StaticResource Refresh}">
                                                    <Binding Path="Priority" Converter="{StaticResource PriorityLabel}" />
                                                    <Binding Path="Language" Source="{x:Static loc:Localizer.Current}" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Grid>
                                    <Label Style="{StaticResource Caption}" Text="{Binding DisciplineName}" />
                                    <Label>
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="Tasks_Due">
                                                <Binding Path="DeadlineUtc" Converter="{StaticResource LocalDeadline}" />
                                                <Binding Path="Language" Source="{x:Static loc:Localizer.Current}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label>
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource Refresh}">
                                                <Binding Path="Status" Converter="{StaticResource StatusLabel}" />
                                                <Binding Path="Language" Source="{x:Static loc:Localizer.Current}" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                InputTransparent="True"
                IsVisible="{Binding IsEmpty}"
                Style="{StaticResource Caption}"
                Text="{loc:Loc Tasks_Empty}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
