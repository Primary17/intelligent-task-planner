<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskPlanner.Maui.Pages.UpcomingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:TaskPlanner.Maui.Localization"
    xmlns:vm="clr-namespace:TaskPlanner.Maui.ViewModels"
    Title="{loc:Loc Nav_Upcoming}"
    x:DataType="vm:UpcomingViewModel">

    <Grid Padding="16,12" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Label Style="{StaticResource Caption}" Text="{loc:Loc Upcoming_Hint}" />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <ActivityIndicator HorizontalOptions="Start" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" />
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingSessionRow">
                            <Border Margin="0,6" Padding="14" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="16" Text="{Binding Title}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding DisciplineName}" />
                                    <Label Text="{Binding When}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding Status}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Label
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                InputTransparent="True"
                IsVisible="{Binding IsEmpty}"
                Style="{StaticResource Caption}"
                Text="{loc:Loc Upcoming_Empty}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
