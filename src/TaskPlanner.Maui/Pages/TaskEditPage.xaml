<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TaskPlanner.Maui.Pages.TaskEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:api="clr-namespace:TaskPlanner.Maui.Api"
    xmlns:vm="clr-namespace:TaskPlanner.Maui.ViewModels"
    Title="Завдання"
    x:DataType="vm:TaskEditViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label FontAttributes="Bold" FontSize="22" Text="{Binding Header}" />
            <ActivityIndicator HorizontalOptions="Start" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource FieldLabel}" Text="Дисципліна" />
                    <Picker ItemsSource="{Binding Disciplines}" SelectedItem="{Binding SelectedDiscipline}">
                        <Picker.ItemDisplayBinding>
                            <Binding Path="Name" x:DataType="api:DisciplineDto" />
                        </Picker.ItemDisplayBinding>
                    </Picker>

                    <Label Style="{StaticResource FieldLabel}" Text="Назва" />
                    <Entry Placeholder="Що треба зробити" Text="{Binding Title}" />

                    <Label Style="{StaticResource FieldLabel}" Text="Дедлайн" />
                    <DatePicker Date="{Binding DeadlineLocal}" />

                    <Label Style="{StaticResource FieldLabel}" Text="{Binding Complexity, StringFormat='Складність: {0} з 5'}" />
                    <Slider Maximum="5" Minimum="1" Value="{Binding Complexity}" />

                    <Label Style="{StaticResource FieldLabel}" Text="Пріоритет" />
                    <Picker ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource PriorityLabel}" x:DataType="{x:Null}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>

                    <Label Style="{StaticResource FieldLabel}" Text="Статус" />
                    <Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource StatusLabel}" x:DataType="{x:Null}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>

                    <Label Style="{StaticResource FieldLabel}" Text="Оцінка, хвилини" />
                    <Entry Keyboard="Numeric" Text="{Binding EstimatedMinutes}" />

                    <Label Style="{StaticResource FieldLabel}" Text="Фактично витрачено, хвилини" />
                    <Entry Keyboard="Numeric" Text="{Binding ActualMinutes}" />
                </VerticalStackLayout>
            </Border>

            <Button Margin="0,8,0,0" Command="{Binding SaveCommand}" Text="Зберегти" />
            <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Text="Скасувати" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
