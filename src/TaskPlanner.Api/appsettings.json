{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=Data/taskplanner.db",
    "PostgreSQL": "Host=localhost;Port=5432;Database=planner_db;Username=planner_user;Password=planner_password"
  },
  "Jwt": {
    "Issuer": "TaskPlanner",
    "Audience": "TaskPlannerClients",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:5109",
      "http://127.0.0.1:5109"
    ]
  },
  "Seed": {
    "AdminEmail": "admin@taskplanner.local"
  }
}
